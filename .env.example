# Wallet AI - Environment Configuration Example

# Modo de Operación: 'demo' o 'firebase'
WALLET_AI_ENV=demo

# Firebase Web / Mobile Config (Requerido solo si WALLET_AI_ENV=firebase)
FIREBASE_API_KEY=AIzaSyExampleKey123456789
FIREBASE_AUTH_DOMAIN=wallet-ai-app.firebaseapp.com
FIREBASE_PROJECT_ID=wallet-ai-app
FIREBASE_STORAGE_BUCKET=wallet-ai-app.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Configuración Regional por Defecto
DEFAULT_CURRENCY=MXN
DEFAULT_TIMEZONE=America/Mexico_City
