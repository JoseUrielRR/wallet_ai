rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regla de aislamiento estricto por usuario:
    // Un usuario autenticado solo puede leer y escribir sus propios documentos.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcolección de Tarjetas (Cards)
      match /cards/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcolección de Compras y Movimientos (Purchases)
      match /purchases/{purchaseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcolección de Préstamos (Loans)
      match /loans/{loanId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcolección de Preferencias
      match /preferences/{prefId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Denegar cualquier otro acceso no autorizado por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
